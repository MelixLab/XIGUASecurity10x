{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XIGUA Intercept",
  "version": "10.2.20",
  "identifier": "com.memz-uac.xigua-intercept",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://103.118.245.82:9051/"
    },
    "windows": [
      {
        "label": "main",
        "title": "XIGUA Intercept",
        "width": 400,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "url": "index.html"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "engines": "engines",
      "../suspicious-intercept.html": "suspicious-intercept.html"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "both"
      }
    }
  }
}
