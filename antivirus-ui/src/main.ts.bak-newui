        max-width: 480px;
        max-height: 70vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
        overflow: hidden;
      }
      .cleaning-results-header {
        padding: 16px 20px;
        display: flex;
